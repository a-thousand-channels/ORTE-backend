/*global jQuery */

jQuery(function ($) {
    'use strict';
    if ($('.simple_form.edit_place').length) {
        if ($('#place_sensitive')[0] && $('#place_sensitive')[0].checked) {
            $('#radius_select').show();
        } else {
            $('#radius_select').hide();
        }
        $('#place_sensitive').click(function () {
            $('#radius_select').toggle();
        });
    }
    $('#place_startdate_qualifier').change(function () {
        let d = $('#place_startdate_date').val();
        console.log(d); 
        console.log($(this).val());
        $('#startdate_qualifier_preview').html('<span class="label small">'+translateQualifierDate(d,$(this).val())+'</span>');
    })
    $('#place_enddate_qualifier').change(function () {
        let d = $('#place_enddate_date').val();
        console.log(d); 
        console.log($(this).val());
        $('#enddate_qualifier_preview').html('<span class="label small">'+translateQualifierDate(d,$(this).val())+'</span>');
    })


    // TODO: if element exists:
    if (document.getElementById('add-hyperlink')) {

        // Add a new Hyperlink field
        document.getElementById('add-hyperlink').addEventListener('click', function(e) {
            e.preventDefault();
            const hyperlinksContainer = document.getElementById('hyperlinks');
            const newId = new Date().getTime(); // Unique ID for the new field

            // Create a new nested field HTML
            const newFieldHTML = `
                <div class="nested-fields">
                <label for="place_hyperlinks_attributes_${newId}_url">URL</label>
                <input type="text" name="place[hyperlinks_attributes][${newId}][url]" id="place_hyperlinks_attributes_${newId}_url">

                <label for="place_hyperlinks_attributes_${newId}_linktext">Link Text</label>
                <input type="text" name="place[hyperlinks_attributes][${newId}][linktext]" id="place_hyperlinks_attributes_${newId}_linktext">

                <label for="place_hyperlinks_attributes_${newId}_note">Note</label>
                <textarea name="place[hyperlinks_attributes][${newId}][note]" id="place_hyperlinks_attributes_${newId}_note"></textarea>

                <input type="hidden" name="place[hyperlinks_attributes][${newId}][_destroy]" value="false">
                <a href="#" class="remove-hyperlink" data-target="${newId}">Remove</a>
                </div>
            `;

            hyperlinksContainer.insertAdjacentHTML('beforeend', newFieldHTML);
        });

        // Remove a Hyperlink field
        document.addEventListener('click', function(e) {
            if (e.target.classList.contains('remove-hyperlink')) {
                e.preventDefault();
                const fieldToRemove = e.target.closest('.nested-fields');

                // Mark the field for destruction (Rails will delete it)
                const destroyInput = fieldToRemove.querySelector('input[name*="[_destroy]"]');
                if (destroyInput) {
                destroyInput.value = 'true';
                }

                // Hide the field visually
                fieldToRemove.style.display = 'none';
            }
        });
    }
});

function translateQualifierDate(d,qualifier) {
    let date = new Date(d);
    /* get dayofmonth */
    let day = date.getDate();
    /* get month */
    let month = date.getMonth()+1;
    /* get year */
    let year = date.getFullYear();


    console.log(date);
    console.log(qualifier);
    if (qualifier === 'circa') {
        return "ca. "+year;
    } else if (qualifier === 'exact') {
        return day+"."+month+"."+year;
    } else {
        /* TODO: just 1.1.2020 to 2020 */
        if ( day == '1' && month == '1' ) {
            return year;
        } 
        return day+"."+month+"."+year;
    }


    

}